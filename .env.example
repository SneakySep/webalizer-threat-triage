# Runtime
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
DOCS_ENABLED=true
API_PORT=8000
CELERY_CONCURRENCY=2

# Optional static API-key protection. Leave empty to disable.
TRIAGE_API_KEY=

# JSON array. Example: ["https://app.example.com"]
CORS_ORIGINS=[]

# VirusTotal. Paste your key on the VT_API_KEY line below.
# Public API defaults: 4 requests/minute and 500/day.
VT_API_KEY=
VT_API_BASE_URL=https://www.virustotal.com/api/v3
VT_RATE_LIMIT_PER_MINUTE=4
VT_HTTP_TIMEOUT_SECONDS=30
VT_POLL_INITIAL_DELAY_SECONDS=5
VT_POLL_MAX_DELAY_SECONDS=60
VT_POLL_TIMEOUT_SECONDS=300
VT_MAX_RETRIES=5
VT_RETRY_BASE_SECONDS=15
VT_RETRY_MAX_SECONDS=300

# Redis cache and Celery configuration. Logical DB 2 is the cache.
REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_TTL_SECONDS=86400
TASK_STATUS_TTL_SECONDS=604800
INFLIGHT_LOCK_TTL_SECONDS=3600

# PostgreSQL (compose hostname is "postgres")
POSTGRES_USER=triage
POSTGRES_PASSWORD=triage_dev_password
POSTGRES_DB=triage
DATABASE_URL=postgresql+psycopg://triage:triage_dev_password@postgres:5432/triage

# Verdict thresholds
MALICIOUS_MIN_ENGINES=1
SUSPICIOUS_MIN_ENGINES=1

# Celery execution limits
CELERY_TASK_TIME_LIMIT_SECONDS=900
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=840
